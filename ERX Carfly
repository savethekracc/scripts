repeat task.wait() until _G.WindUI and _G.Functions

local WindUI = _G.WindUI
local Tabs   = _G.Tabs

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")

local Player = Players.LocalPlayer

getgenv()._CarFlySpeed = 50

local enabled = false
local bind = Enum.KeyCode.J

local hb, gy, vl
local CarFlyToggle

local function clean()
	if hb then hb:Disconnect() hb = nil end
	if vl then pcall(function() vl:Destroy() end) vl = nil end
	if gy then pcall(function() gy:Destroy() end) gy = nil end
end

local function attach()
	local c = Player.Character
	if not c then return end

	local h = c:FindFirstChildOfClass("Humanoid")
	if not h or not h.Sit then return end

	local seat = h.SeatPart
	if not seat then return end

	local vehicle = seat.Parent
	if not vehicle or not vehicle:FindFirstChild("Body") then return end

	local col = vehicle.Body:FindFirstChild("CollisionPart")
	if not col then return end

	for _, d in ipairs(vehicle:GetDescendants()) do
		if d:IsA("TouchTransmitter") then
			d:Destroy()
		end
	end

	workspace.CurrentCamera.CameraSubject = h

	gy = Instance.new("BodyGyro")
	gy.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	gy.P = 9e4
	gy.Parent = col

	vl = Instance.new("BodyVelocity")
	vl.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	vl.P = 9e4
	vl.Parent = col

	hb = RunService.Heartbeat:Connect(function()
		if not enabled then
			vl.Velocity = Vector3.zero
			return
		end

		if not h.Sit then
			CarFlyToggle:Set(false)
			return
		end

		local cam = workspace.CurrentCamera.CFrame
		local dir = Vector3.zero

		if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
		if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end

		vl.Velocity = dir * getgenv()._CarFlySpeed
		gy.CFrame = cam
	end)
end

local function setCarFly(state)
	enabled = state

	if state then
		attach()
	else
		clean()
	end
end

UIS.InputBegan:Connect(function(i, g)
	if g then return end
	if i.KeyCode ~= bind then return end

	local h = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
	if not h or not h.Sit then return end

	CarFlyToggle:Set(not enabled)
end)

Tabs.VehicleMods:Section({
	Title = "Car Fly",
	TextSize = 16,
})

CarFlyToggle = Tabs.VehicleMods:Toggle({
	Title = "Car Fly",
	Desc = "Fly your vehicle (Keybind: J)",
	Value = false,
	Callback = function(v)
		setCarFly(v)
	end,
})

Tabs.VehicleMods:Slider({
	Title = "Car Fly Speed",
	Desc = "Adjust how fast the vehicle flies",
	Value = {
		Min = 10,
		Max = 250,
		Default = 50,
	},
	Callback = function(n)
		getgenv()._CarFlySpeed = tonumber(n)
		WindUI:Notify({
			Title = "Car Fly Speed",
			Content = "Set speed to " .. n,
			Duration = 2,
		})
	end,
})

WindUI:Notify({
	Title = "Car Jump",
	Content = "Car fly loaded! Press J to fly.",
	Duration = 3,
})
